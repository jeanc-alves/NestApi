DATABASE_PASSWORD=root
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE}?schema=public"

JWT_SECRET=supersecret_jwt_development_key_min16chars

RABBITMQ_URL="amqp://guest:guest@localhost:5672"

